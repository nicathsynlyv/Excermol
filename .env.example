# Bu faylın məqsədi : kimsə (ya da sən özün, gələcəkdə) layihəni klonlayanda, hansı environment variable-ları təyin etməli olduğunu asanlıqla görəciyik!

# Database
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# OAuth2 Google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OAuth2 Facebook
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Email (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Logging
LOG_FILE_PATH=/app/logs/application.log

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_min_256_bits
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=2592000000

# OAuth2 Redirect
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/redirect